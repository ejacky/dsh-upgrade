{
  "name": "dsh-upgrade",
  "version": "0.1.0",
  "description": "Short-restart upgrades for DeepSeek Harness source checkouts on Windows and Linux: dual-slot checkouts behind one stable-path link.",
  "type": "module",
  "bin": {
    "dsh-upgrade": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node src/cli.ts"
  },
  "files": [
    "src",
    "engine-ps",
    "patches",
    "assets",
    "scripts",
    "setup.cmd",
    "setup.sh",
    "version.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "upgrade",
    "zero-downtime",
    "windows",
    "linux"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
